    ") -> tuple[int, dict[str, int]]:\n",
    "    \"\"\"Write missing measurement cells as NaN without dropping source rows.\"\"\"\n",
    "    headers = list(pd.read_csv(data_path, nrows=0, dtype=str, keep_default_na=False).columns)\n",
    "    missing_columns = set(feature_columns) - set(headers)\n",
    "    if missing_columns:\n",
    "        raise ValueError(f\"{data_path.name}: missing measurement columns {sorted(missing_columns)}\")\n",
    "\n",
    "    missing_counts = dict.fromkeys(feature_columns, 0)\n",
    "    rows_written = 0\n",
    "    temporary_path = None\n",
    "    try:\n",
    "        with tempfile.NamedTemporaryFile(\n",
    "            mode=\"w\", encoding=\"utf-8\", newline=\"\", suffix=\".csv\",\n",
    "            prefix=f\".{data_path.stem}.\", dir=data_path.parent, delete=False,\n",
