    "import tempfile\n",
    "\n",
    "\n",
    "def split_occupancy_csv_by_floorspace(\n",
    "    csv_path: Path,\n",
    "    output_dir: Path,\n",
    "    chunksize: int = 100_000,\n",
    ") -> dict[str, int]:\n",
    "    \"\"\"Validate occupancy chunks and write reduced streams by floorspace ID.\n",
    "\n",
    "    Each chunk is checked against the occupancy constant-column contract before\n",
    "    writing. The reduced output omits the configured columns, preserves all\n",
    "    other columns and source order, and never modifies the raw input. Output is\n",
    "    staged and published only after the full input has passed validation.\n",
    "\n",
    "    Returns a mapping from floorspace ID to the number of rows written.\n",
    "    \"\"\"\n",
    "    csv_path = Path(csv_path)\n",
    "    output_dir = Path(output_dir)\n",
    "    if output_dir.exists():\n",
    "        raise FileExistsError(f\"Output directory already exists: {output_dir}\")\n",
    "\n",
    "    headers = list(pd.read_csv(csv_path, nrows=0, dtype=str, keep_default_na=False).columns)\n",
    "    if \"floorspaceid\" not in headers:\n",
    "        raise ValueError(f\"{csv_path.name}: required column 'floorspaceid' is missing\")\n",
    "\n",
    "    missing_exclusions = OCCUPANCY_COLUMNS_TO_EXCLUDE - set(headers)\n",
    "    if missing_exclusions:\n",
    "        raise ValueError(\n",
    "            f\"{csv_path.name}: reduced-data columns are missing {sorted(missing_exclusions)}\"\n",
    "        )\n",
    "    selected_columns = [\n",
    "        column for column in headers if column not in OCCUPANCY_COLUMNS_TO_EXCLUDE\n",
    "    ]\n",
    "    required_validation_columns = set(EXPECTED_OCCUPANCY_CONSTANTS)\n",
    "    columns_needed = set(selected_columns) | required_validation_columns\n",
    "    read_columns = [\n",
    "        column for column in headers if column in columns_needed\n",
    "    ]\n",
    "\n",
    "    invalid_filename_chars = '<>:\"/\\\\|?*'\n",
    "    row_counts: dict[str, int] = {}\n",
    "    output_dir.parent.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    with tempfile.TemporaryDirectory(\n",
    "        dir=output_dir.parent,\n",
    "        prefix=f\".{output_dir.name}.\",\n",
    "    ) as staging_path:\n",
    "        staging_dir = Path(staging_path)\n",
    "        for chunk in pd.read_csv(\n",
    "            csv_path,\n",
    "            usecols=read_columns,\n",
    "            dtype=str,\n",
    "            keep_default_na=False,\n",
    "            chunksize=chunksize,\n",
    "        ):\n",
    "            validate_constant_columns(\n",
    "                chunk,\n",
    "                EXPECTED_OCCUPANCY_CONSTANTS,\n",
    "                \"Occupancy sensor data\",\n",
    "            )\n",
