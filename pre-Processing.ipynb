    "            ):\n",
    "                for column in feature_columns:\n",
    "                    values = chunk[column].str.strip()\n",
    "                    is_missing = values.str.casefold().isin(MISSING_TOKENS)\n",
    "                    numeric = pd.to_numeric(values.mask(is_missing), errors=\"coerce\")\n",
    "                    invalid = ~is_missing & numeric.isna()\n",
    "                    if invalid.any():\n",
    "                        raise ValueError(\n",
    "                            f\"{data_path.name}: non-numeric values in {column}: \"\n",
    "                            f\"{values.loc[invalid].iloc[0]!r}\"\n",
    "                        )\n",
    "                    missing_counts[column] += int(is_missing.sum())\n",
    "                    chunk[column] = numeric\n",
    "                chunk.to_csv(\n",
    "                    temporary_file, index=False, header=first_chunk,\n",
    "                    lineterminator=\"\\n\", na_rep=\"NaN\",\n",
    "                )\n",
