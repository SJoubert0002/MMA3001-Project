    "from pathlib import Path\n",
    "import shutil\n",
    "import tempfile\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "def audit_changedate_pattern(stream_path: Path) -> dict[str, object]:\n",
    "    \"\"\"Summarize the observed status-change timestamp pattern for one stream.\n",
    "\n",
    "    Observations are ordered by collected time, with numeric record ID as a\n",
    "    deterministic tie-breaker. Zero readings and positive-run starts are\n",
    "    checked against their own collected time; consecutive positive readings\n",
    "    are checked for an unchanged status-change time.\n",
    "    \"\"\"\n",
    "    headers = list(pd.read_csv(stream_path, nrows=0, dtype=str, keep_default_na=False).columns)\n",
    "    id_column = \"id\" if \"id\" in headers else \"Fid\" if \"Fid\" in headers else None\n",
    "    if id_column is None:\n",
    "        raise ValueError(f\"{stream_path.name}: expected an 'id' or 'Fid' record identifier\")\n",
    "    data = pd.read_csv(\n",
    "        stream_path,\n",
    "        usecols=[id_column, \"headcount\", \"collecteddate\", \"occupancystatuschangedate\"],\n",
    "        dtype=str,\n",
    "        keep_default_na=False,\n",
    "    )\n",
    "    data[\"id_numeric\"] = pd.to_numeric(data[id_column], errors=\"coerce\")\n",
    "    data[\"headcount_numeric\"] = pd.to_numeric(data[\"headcount\"], errors=\"coerce\")\n",
    "    data[\"collected_utc\"] = pd.to_datetime(data[\"collecteddate\"], errors=\"coerce\", utc=True)\n",
    "    data[\"changed_utc\"] = pd.to_datetime(\n",
    "        data[\"occupancystatuschangedate\"], errors=\"coerce\", utc=True\n",
    "    )\n",
    "    invalid = (\n",
    "        data[\"id_numeric\"].isna()\n",
    "        | data[\"headcount_numeric\"].isna()\n",
    "        | data[\"collected_utc\"].isna()\n",
    "        | data[\"changed_utc\"].isna()\n",
    "    )\n",
    "    if invalid.any():\n",
    "        bad_id = data.loc[invalid, id_column].iloc[0]\n",
    "        raise ValueError(f\"{stream_path.name}: invalid analysis value at id {bad_id!r}\")\n",
    "\n",
    "    data = data.sort_values([\"collected_utc\", \"id_numeric\"], kind=\"stable\").reset_index(drop=True)\n",
    "    headcount = data[\"headcount_numeric\"]\n",
    "    changed = data[\"changed_utc\"]\n",
    "    collected = data[\"collected_utc\"]\n",
    "    previous_headcount = headcount.shift()\n",
    "    previous_changed = changed.shift()\n",
    "\n",
    "    zero_reading = headcount.eq(0)\n",
    "    positive = headcount.gt(0)\n",
    "    positive_start_after_zero = positive & previous_headcount.eq(0)\n",
    "    consecutive_positive = positive & previous_headcount.gt(0)\n",
    "    zero_matches = zero_reading & changed.eq(collected)\n",
    "    start_matches = positive_start_after_zero & changed.eq(collected)\n",
    "    continuation_matches = consecutive_positive & changed.eq(previous_changed)\n",
    "    start_breaks = positive_start_after_zero & ~changed.eq(collected)\n",
    "    continuation_breaks = consecutive_positive & ~changed.eq(previous_changed)\n",
    "\n",
    "    def first_id(mask: pd.Series) -> str:\n",
    "        selected = data.loc[mask, id_column]\n",
    "        return str(selected.iloc[0]) if not selected.empty else \"\"\n",
    "\n",
    "    zero_count = int(zero_reading.sum())\n",
    "    start_count = int(positive_start_after_zero.sum())\n",
    "    continuation_count = int(consecutive_positive.sum())\n",
    "    return {\n",
    "        \"floorspaceid\": stream_path.stem,\n",
    "        \"rows\": len(data),\n",
    "        \"zero_readings\": zero_count,\n",
    "        \"zero_time_matches\": int(zero_matches.sum()),\n",
    "        \"positive_starts_after_zero\": start_count,\n",
    "        \"positive_start_time_matches\": int(start_matches.sum()),\n",
    "        \"positive_start_first_exception_id\": first_id(start_breaks),\n",
    "        \"successive_positive_pairs\": continuation_count,\n",
    "        \"unchanged_time_in_positive_run\": int(continuation_matches.sum()),\n",
    "        \"positive_run_time_changes\": int(continuation_breaks.sum()),\n",
    "        \"positive_run_first_exception_id\": first_id(continuation_breaks),\n",
    "    }\n",
    "\n",
    "\n",
    "def audit_and_remove_changedate_from_derived_streams(streams_dir: Path) -> pd.DataFrame:\n",
    "    \"\"\"Audit existing derived streams, then replace them without changedate.\n",
    "\n",
    "    All replacements are staged and row/header checked before the existing\n",
    "    derived directory is swapped out. The raw occupancy CSV is not touched.\n",
    "    An audit CSV is retained so the pattern results remain available after\n",
    "    the timestamp column has been removed.\n",
    "    \"\"\"\n",
    "    streams_dir = Path(streams_dir)\n",
    "    audit_path = streams_dir / \"occupancystatuschangedate_audit.csv\"\n",
    "    manifest_path = streams_dir / \"stream_row_counts.csv\"\n",
    "    if not streams_dir.is_dir():\n",
    "        raise FileNotFoundError(f\"Derived stream directory does not exist: {streams_dir}\")\n",
    "\n",
    "    stream_paths = sorted(\n",
    "        path for path in streams_dir.glob(\"*.csv\")\n",
    "        if path.name not in {manifest_path.name, audit_path.name}\n",
    "    )\n",
    "    if not stream_paths:\n",
    "        raise ValueError(f\"No derived stream CSVs found in {streams_dir}\")\n",
    "\n",
    "    headers_by_path = {\n",
    "        path: list(pd.read_csv(path, nrows=0, dtype=str, keep_default_na=False).columns)\n",
    "        for path in stream_paths\n",
    "    }\n",
    "    has_changedate = [\"occupancystatuschangedate\" in headers for headers in headers_by_path.values()]\n",
    "    if all(not present for present in has_changedate):\n",
    "        if not audit_path.is_file():\n",
    "            raise ValueError(\n",
    "                \"The change-date column is already absent, but its saved audit summary is missing.\"\n",
    "            )\n",
    "        return pd.read_csv(audit_path, dtype={\"floorspaceid\": str}, keep_default_na=False)\n",
    "    if not all(has_changedate):\n",
    "        raise ValueError(\"Derived streams have inconsistent change-date columns; no files were changed.\")\n",
    "\n",
    "    if not manifest_path.is_file():\n",
    "        raise FileNotFoundError(f\"Derived row-count manifest is missing: {manifest_path}\")\n",
    "    manifest = pd.read_csv(manifest_path, dtype={\"floorspaceid\": str})\n",
    "    expected_rows = dict(zip(manifest[\"floorspaceid\"], manifest[\"row_count\"].astype(int)))\n",
    "    if set(expected_rows) != {path.stem for path in stream_paths}:\n",
    "        raise ValueError(\"Stream files do not match the floorspace IDs in the row-count manifest.\")\n",
    "\n",
    "    audit_results = []\n",
    "    retained_columns_by_path = {}\n",
    "    for path in stream_paths:\n",
    "        headers = headers_by_path[path]\n",
    "        if \"floorspaceid\" not in headers or \"collecteddate\" not in headers:\n",
    "            raise ValueError(f\"{path.name}: required floorspace/time column is missing\")\n",
    "        result = audit_changedate_pattern(path)\n",
    "        if result[\"rows\"] != expected_rows[path.stem]:\n",
    "            raise ValueError(\n",
    "                f\"{path.name}: row count {result['rows']} differs from manifest \"\n",
    "                f\"{expected_rows[path.stem]}\"\n",
    "            )\n",
    "        audit_results.append(result)\n",
    "        retained_columns_by_path[path.name] = [\n",
    "            column for column in headers if column != \"occupancystatuschangedate\"\n",
    "        ]\n",
    "\n",
    "    audit = pd.DataFrame(audit_results)\n",
    "    backup_dir = streams_dir.with_name(f\".{streams_dir.name}.before_changedate_removal\")\n",
    "    if backup_dir.exists():\n",
    "        raise FileExistsError(f\"Refusing to replace existing backup directory: {backup_dir}\")\n",
    "\n",
    "    with tempfile.TemporaryDirectory(\n",
    "        dir=streams_dir.parent,\n",
    "        prefix=f\".{streams_dir.name}.staging.\",\n",
    "    ) as temporary_root:\n",
    "        staging_dir = Path(temporary_root) / streams_dir.name\n",
    "        staging_dir.mkdir()\n",
    "        for path in stream_paths:\n",
    "            row_count = 0\n",
    "            first_chunk = True\n",
    "            for chunk in pd.read_csv(path, dtype=str, keep_default_na=False, chunksize=100_000):\n",
    "                chunk = chunk.drop(columns=[\"occupancystatuschangedate\"])\n",
    "                chunk.to_csv(\n",
    "                    staging_dir / path.name,\n",
    "                    mode=\"w\" if first_chunk else \"a\",\n",
    "                    header=first_chunk,\n",
    "                    index=False,\n",
    "                )\n",
    "                row_count += len(chunk)\n",
    "                first_chunk = False\n",
    "            if row_count != expected_rows[path.stem]:\n",
    "                raise ValueError(f\"{path.name}: staged row count changed during column removal\")\n",
    "            staged_headers = list(\n",
    "                pd.read_csv(staging_dir / path.name, nrows=0, dtype=str, keep_default_na=False).columns\n",
    "            )\n",
    "            if staged_headers != retained_columns_by_path[path.name]:\n",
    "                raise ValueError(f\"{path.name}: staged columns differ from the expected reduced schema\")\n",
    "\n",
    "        shutil.copy2(manifest_path, staging_dir / manifest_path.name)\n",
    "        audit.to_csv(staging_dir / audit_path.name, index=False)\n",
    "\n",
    "        streams_dir.rename(backup_dir)\n",
    "        try:\n",
    "            staging_dir.rename(streams_dir)\n",
    "        except OSError:\n",
    "            backup_dir.rename(streams_dir)\n",
    "            raise\n",
    "        shutil.rmtree(backup_dir)\n",
    "\n",
    "    return audit\n",
    "\n",
    "\n",
    "OCCUPANCY_STREAMS_DIR = Path(\"derived\") / \"occupancy_streams_by_floorspace\"\n",
    "changedate_audit = audit_and_remove_changedate_from_derived_streams(\n",
    "    OCCUPANCY_STREAMS_DIR\n",
    ")\n",
    "display(changedate_audit)\n",
    "print(\n",
    "    \"Positive-run timestamp retained in \"\n",
    "    f\"{int(changedate_audit['unchanged_time_in_positive_run'].sum()):,}/\"\n",
    "    f\"{int(changedate_audit['successive_positive_pairs'].sum()):,} successive-positive pairs.\"\n",
    ")\n",
    "print(\n",
    "    \"Derived stream CSVs now omit occupancystatuschangedate; audit results are saved at \"\n",
    "    f\"{OCCUPANCY_STREAMS_DIR / 'occupancystatuschangedate_audit.csv'}.\"\n",
    ")"
   ]
