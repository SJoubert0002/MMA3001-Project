    "ENV_WIDE_CONSTANTS = {\"sensor_id\": EXPECTED_ID, \"devicetype\": \"env\"}\n",
    "ENV_WIDE_REQUIRED_COLUMNS = {\"source_record_id\", \"createdate\", \"timestamp_utc\"}\n",
    "ENV_WIDE_OPTIONAL_COLUMNS = {\"sensor_id\", \"devicetype\", \"processdate\"}\n",
    "\n",
    "\n",
    "def validate_environmental_wide_csv(\n",
    "    csv_path: Path,\n",
    "    schema_path: Path,\n",
    "    raw_csv_path: Path,\n",
    "    allow_reduced: bool = False,\n",
    "    chunksize: int = 100_000,\n",
    ") -> dict[str, object]:\n",
    "    \"\"\"Validate the expanded environmental CSV, its values, and raw record IDs.\"\"\"\n",
    "    headers = list(pd.read_csv(csv_path, nrows=0, dtype=str, keep_default_na=False).columns)\n",
    "    if len(headers) != len(set(headers)):\n",
    "        raise ValueError(f\"{csv_path.name}: duplicate output columns\")\n",
    "    missing = ENV_WIDE_REQUIRED_COLUMNS - set(headers)\n",
    "    if not allow_reduced:\n",
    "        missing |= ENV_WIDE_OPTIONAL_COLUMNS - set(headers)\n",
    "    if missing:\n",
    "        raise ValueError(f\"{csv_path.name}: missing columns {sorted(missing)}\")\n",
    "\n",
    "    schema = pd.read_csv(schema_path, dtype=str, keep_default_na=False)\n",
    "    if not {\"variable_id\", \"output_column\"}.issubset(schema.columns):\n",
    "        raise ValueError(f\"{schema_path.name}: variable schema columns are missing\")\n",
    "    feature_columns = list(schema[\"output_column\"])\n",
    "    if not feature_columns or len(feature_columns) != len(set(feature_columns)):\n",
    "        raise ValueError(f\"{schema_path.name}: feature columns must be non-empty and unique\")\n",
    "    optional_columns = set(headers) & ENV_WIDE_OPTIONAL_COLUMNS\n",
    "    if set(headers) != ENV_WIDE_REQUIRED_COLUMNS | optional_columns | set(feature_columns):\n",
    "        raise ValueError(f\"{csv_path.name}: columns do not match the variable schema\")\n",
    "\n",
    "    constants_present = {\n",
    "        column: value for column, value in ENV_WIDE_CONSTANTS.items() if column in headers\n",
    "    }\n",
    "    if constants_present:\n",
    "        validate_csv_constant_columns(\n",
    "            csv_path, constants_present, \"Expanded environmental data\", chunksize\n",
    "        )\n",
    "    record_timestamps = (\n",
    "        summarize_csv_timestamp_pair(\n",
    "            csv_path, \"createdate\", \"processdate\", \"Expanded environmental data\", chunksize\n",
    "        )\n",
    "        if {\"createdate\", \"processdate\"}.issubset(headers)\n",
    "        else None\n",
    "    )\n",
    "    measurement_timestamps = summarize_csv_timestamp_pair(\n",
    "        csv_path, \"createdate\", \"timestamp_utc\", \"Record versus measurement time\", chunksize\n",
    "    )\n",
    "\n",
    "    raw_ids = set()\n",
    "    for chunk in pd.read_csv(\n",
    "        raw_csv_path, usecols=[\"id\"], dtype=str, keep_default_na=False, chunksize=chunksize\n",
    "    ):\n",
    "        raw_ids.update(chunk[\"id\"])\n",
    "    output_ids = set()\n",
    "    rows = 0\n",
    "    for chunk in pd.read_csv(csv_path, dtype=str, keep_default_na=False, chunksize=chunksize):\n",
    "        rows += len(chunk)\n",
    "        ids = chunk[\"source_record_id\"]\n",
    "        if ids.eq(\"\").any() or ids.duplicated().any() or not output_ids.isdisjoint(ids):\n",
    "            raise ValueError(f\"{csv_path.name}: source_record_id is blank or duplicated\")\n",
    "        output_ids.update(ids)\n",
    "        timestamps = pd.to_datetime(chunk[\"timestamp_utc\"], errors=\"coerce\", utc=True)\n",
    "        if timestamps.isna().any():\n",
    "            raise ValueError(f\"{csv_path.name}: invalid or missing measurement timestamp\")\n",
    "        for column in feature_columns:\n",
    "            values = chunk[column]\n",
    "    is_missing = values.str.strip().str.casefold().isin({\"\", \"nan\", \"null\", \"none\"})\n",
    "    numeric = pd.to_numeric(values.mask(is_missing), errors=\"coerce\")\n",
    "    if ((~is_missing) & numeric.isna()).any():\n",
    "        raise ValueError(f\"{csv_path.name}: non-numeric values in {column}\")\n",
    "\n",
    "    if rows == 0 or output_ids != raw_ids:\n",
    "        raise ValueError(f\"{csv_path.name}: no data or source IDs differ from raw input\")\n",
    "    return {\n",
    "        \"rows\": rows,\n",
    "        \"columns\": len(headers),\n",
    "        \"feature_columns\": feature_columns,\n",
    "        \"record_timestamps\": record_timestamps,\n",
    "        \"measurement_timestamps\": measurement_timestamps,\n",
    "    }\n",
    "\n",
    "\n",
    "def write_reduced_environmental_wide_csv(\n",
    "    source_path: Path,\n",
    "    output_path: Path,\n",
    "    selected_columns: list[str],\n",
    "    expected_rows: int,\n",
    "    chunksize: int = 100_000,\n",
    ") -> int:\n",
    "    \"\"\"Write a checked reduced copy while preserving the full derived CSV.\"\"\"\n",
    "    import os\n",
    "    import tempfile\n",
    "\n",
    "    output_path.parent.mkdir(parents=True, exist_ok=True)\n",
    "    temporary_path = None\n",
    "    rows_written = 0\n",
    "    try:\n",
    "        with tempfile.NamedTemporaryFile(\n",
    "            mode=\"w\", encoding=\"utf-8\", newline=\"\", suffix=\".csv\",\n",
    "            prefix=f\".{output_path.stem}.\", dir=output_path.parent, delete=False,\n",
    "        ) as temporary_file:\n",
    "            temporary_path = Path(temporary_file.name)\n",
    "            first_chunk = True\n",
    "            for chunk in pd.read_csv(\n",
    "                source_path, usecols=selected_columns, dtype=str,\n",
    "                keep_default_na=False, chunksize=chunksize,\n",
    "            ):\n",
    "                chunk.to_csv(\n",
    "                    temporary_file, index=False, header=first_chunk, lineterminator=\"\\n\"\n",
    "                )\n",
    "                rows_written += len(chunk)\n",
    "                first_chunk = False\n",
    "        if rows_written != expected_rows:\n",
    "            raise ValueError(f\"Reduced output has {rows_written} rows; expected {expected_rows}\")\n",
    "        actual_columns = list(\n",
    "            pd.read_csv(temporary_path, nrows=0, dtype=str, keep_default_na=False).columns\n",
    "        )\n",
    "        if actual_columns != selected_columns:\n",
    "            raise ValueError(\"Reduced output schema differs from the selected columns\")\n",
    "        os.replace(temporary_path, output_path)\n",
    "        temporary_path = None\n",
    "        return rows_written\n",
    "    finally:\n",
    "        if temporary_path is not None and temporary_path.exists():\n",
    "            temporary_path.unlink()\n",
    "\n",
    "\n",
    "env_wide_validation = validate_environmental_wide_csv(\n",
    "    ENV_WIDE_CSV_PATH, ENV_WIDE_SCHEMA_PATH, ENV_CSV_PATH\n",
    ")\n",
    "env_wide_benchmark = benchmark_csv_column_selection(\n",
    "    ENV_WIDE_CSV_PATH,\n",
    "    {\"sensor_id\", \"devicetype\"},\n",
    "    timestamp_pair=(\"createdate\", \"processdate\"),\n",
    ")\n",
    "env_wide_excluded_columns = set(env_wide_benchmark[\"excluded_columns\"])\n",
    "env_wide_selected_columns = [\n",
    "    column\n",
    "    for column in pd.read_csv(ENV_WIDE_CSV_PATH, nrows=0).columns\n",
    "    if column not in env_wide_excluded_columns\n",
    "]\n",
    "env_wide_reduced_rows = write_reduced_environmental_wide_csv(\n",
    "    ENV_WIDE_CSV_PATH, ENV_WIDE_REDUCED_PATH, env_wide_selected_columns,\n",
    "    env_wide_validation[\"rows\"],\n",
    ")\n",
    "env_wide_reduced_validation = validate_environmental_wide_csv(\n",
    "    ENV_WIDE_REDUCED_PATH, ENV_WIDE_SCHEMA_PATH, ENV_CSV_PATH, allow_reduced=True\n",
    ")\n",
    "if env_wide_reduced_validation[\"rows\"] != env_wide_validation[\"rows\"]:\n",
    "    raise ValueError(\"Reduced environmental output row count differs from full output\")\n",
    "env_wide_reduced_benchmark = benchmark_csv_column_selection(ENV_WIDE_REDUCED_PATH, set())\n",
    "env_wide_benchmark_results = {\n",
    "    ENV_WIDE_CSV_PATH.name: env_wide_benchmark,\n",
    "    ENV_WIDE_REDUCED_PATH.name: env_wide_reduced_benchmark,\n",
    "}\n",
    "\n",
    "validation_rows = [\n",
    "    {\"check\": \"wide_schema_and_raw_ids\", \"result\": \"PASS\", \"observed\": env_wide_validation[\"rows\"], \"expected\": \"raw record IDs match\", \"notes\": f\"{env_wide_validation['columns']} columns; {len(env_wide_validation['feature_columns'])} measurements.\"},\n",
    "    {\"check\": \"invariant_columns\", \"result\": \"PASS\", \"observed\": \"sensor_id=6012000000000; devicetype=env\", \"expected\": \"constant on all rows\", \"notes\": \"Validated before candidate columns are excluded.\"},\n",
    "    {\"check\": \"createdate_processdate\", \"result\": \"PASS\" if env_wide_validation[\"record_timestamps\"][\"equal_rows\"] == env_wide_validation[\"rows\"] else \"REVIEW\", \"observed\": f\"{env_wide_validation['record_timestamps']['equal_rows']} equal; {env_wide_validation['record_timestamps']['unequal_rows']} unequal; {env_wide_validation['record_timestamps']['unparseable_rows']} unparseable\", \"expected\": \"all equal to exclude processdate\", \"notes\": \"Compared parsed UTC instants; createdate is retained.\"},\n",
    "    {\"check\": \"createdate_measurement_time\", \"result\": \"INFO\", \"observed\": f\"{env_wide_validation['measurement_timestamps']['equal_rows']} equal; {env_wide_validation['measurement_timestamps']['unequal_rows']} unequal; {env_wide_validation['measurement_timestamps']['unparseable_rows']} unparseable\", \"expected\": \"report only\", \"notes\": \"timestamp_utc is the sensor measurement time and is retained.\"},\n",
    "    {\"check\": \"reduced_output_rows\", \"result\": \"PASS\", \"observed\": env_wide_reduced_rows, \"expected\": env_wide_validation[\"rows\"], \"notes\": f\"Retained columns: {env_wide_selected_columns}.\"},\n",
    "]\n",
    "pd.DataFrame(validation_rows).to_csv(ENV_WIDE_VALIDATION_PATH, index=False)\n",
    "benchmark_rows = []\n",
    "for dataset_name, results in env_wide_benchmark_results.items():\n",
    "    for read_type in (\"full_read\", \"reduced_read\"):\n",
    "        benchmark_rows.append({\"dataset\": dataset_name, \"read_type\": read_type, **results[read_type], \"excluded_columns\": results[\"excluded_columns\"]})\n",
    "pd.DataFrame(benchmark_rows).to_csv(ENV_WIDE_BENCHMARK_PATH, index=False)\n",
    "\n",
    "\n",
    "class TestEnvironmentalWideOutput(unittest.TestCase):\n",
    "    def test_source_and_wide_row_counts_match(self):\n",
    "        self.assertEqual(env_wide_reduced_rows, env_wide_validation[\"rows\"])\n",
    "\n",
    "    def test_timestamp_columns_are_handled_by_meaning(self):\n",
    "        pair = env_wide_validation[\"record_timestamps\"]\n",
    "        self.assertEqual(pair[\"equal_rows\"], pair[\"rows\"])\n",
    "        self.assertIn(\"processdate\", env_wide_excluded_columns)\n",
    "        self.assertNotIn(\"timestamp_utc\", env_wide_excluded_columns)\n",
    "\n",
    "    def test_full_and_reduced_reads_preserve_row_count(self):\n",
    "        self.assertEqual(\n",
    "            env_wide_benchmark[\"full_read\"][\"rows\"],\n",
    "            env_wide_benchmark[\"reduced_read\"][\"rows\"],\n",
    "        )\n",
    "\n",
    "\n",
    "wide_test_result = unittest.TextTestRunner(verbosity=2).run(\n",
    "    unittest.defaultTestLoader.loadTestsFromTestCase(TestEnvironmentalWideOutput)\n",
    ")\n",
    "assert wide_test_result.wasSuccessful(), \"Environmental wide-data validation failed\"\n",
    "print(f\"Validated {env_wide_validation['rows']:,} wide environmental rows.\")\n",
    "print(f\"createdate/processdate equality: {env_wide_validation['record_timestamps']['equal_rows']:,}/{env_wide_validation['rows']:,}.\")\n",
    "print(f\"Reduced columns excluded after checks: {sorted(env_wide_excluded_columns)}\")\n",
    "print(f\"Reduced file: {ENV_WIDE_REDUCED_PATH} ({len(env_wide_selected_columns)} columns).\")\n",
    "for dataset_name, results in env_wide_benchmark_results.items():\n",
    "    print(f\"\\n{dataset_name}\")\n",
    "    for read_type in (\"full_read\", \"reduced_read\"):\n",
    "        metrics = results[read_type]\n",
    "        print(f\"  {read_type}: {metrics['rows']:,} rows, {metrics['columns']} columns, {metrics['elapsed_seconds']:.2f} s, largest chunk {metrics['largest_chunk_mib']:.2f} MiB\")\n",
    "    print(f\"  Excluded columns: {results['excluded_columns']}\")"
   ]
